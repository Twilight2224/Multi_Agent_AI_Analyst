# Required: obtain your own class-proxy key and keep the real value only in .env.
GEMINI_API_KEY=

# Optional integrations
TAVILY_API_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Runtime configuration
DATABASE_URL=sqlite:///data/company.db
QDRANT_PATH=storage/qdrant
FRONTEND_ORIGIN=http://localhost:3000
MAX_GRAPH_STEPS=12
